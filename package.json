{
  "name": "@rajvarsani/cosmos",
  "version": "0.4.0",
  "description": "Isolated instances of a project's docker compose stack on one machine, with per-instance worktrees, an edge, shares and a dashboard.",
  "type": "module",
  "bin": {
    "cosmos": "bin/cosmos"
  },
  "exports": {
    "./adapter": {
      "types": "./src/api.ts",
      "default": "./src/api.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/*.ts",
    "src/runtime/*.ts",
    "src/runtime/providers/*.ts",
    "src/dashboard/*.ts",
    "src/tui/",
    "src/dashboard/app/dist/",
    "docker/go-air.Dockerfile",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test",
    "build:dashboard": "cd src/dashboard/app && bun install --frozen-lockfile && bun run build",
    "leak-check": "bash scripts/leak-check.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.3",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RajVarsani/cosmos.git"
  },
  "homepage": "https://github.com/RajVarsani/cosmos#readme",
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  }
}
